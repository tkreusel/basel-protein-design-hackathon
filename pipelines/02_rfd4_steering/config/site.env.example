# Site configuration. Copy to config/site.env and edit; every job script sources it (via jobs/lib.sh).
# Nothing else in the pipeline contains machine-specific paths.

# --- campaign ---------------------------------------------------------------------------------------------
export CAMP=20261122_kemp_c1                      # campaign name: runs/<CAMP>/<motif>/<arm>/bNN
export KEMP_SCRATCH=/path/to/scratch/kemp_campaign   # runs/, logs/, caches (large; not backed up is fine, archive_runs.sh packs results)
export KEMP_RESULTS=/path/to/kemp_results         # tables, figures and per-sequence folders written by export_results.py

# --- interpreters and tools ---------------------------------------------------------------------------------
export PY_RFD4=$KEMP_PIPELINE/rfd4/.venv/bin/python   # RFD4-Proteina venv; also runs tmol, biotite, pandas (gate and analysis scripts)
export PY_BOLTZ_BIN=/path/to/boltz/bin               # directory containing the `boltz` executable
export BOLTZ_CACHE=/path/to/boltz_cache              # Boltz-2 weights
export LIGANDMPNN_DIR=/path/to/LigandMPNN            # repository clone
export LIGANDMPNN_PY=/path/to/lmpnn_env/bin/python
export LIGANDMPNN_WEIGHTS=/path/to/ligandmpnn_weights  # directory with ligandmpnn_v_32_010_25.pt
export PY_PLACER=/path/to/placer_env/bin/python      # PLACER (torch 2.3, DGL)
export PLACER_ROOT=/path/to/PLACER
export IPSAE_BIN=/path/to/ipsae2_env/bin/ipsae
export PY_ROSETTA=/path/to/pyrosetta_env/bin/python  # PyRosetta (academic licence)
export PY_TMOL=$PY_RFD4                              # tmol protocol runs in the RFD4 venv
export HF_HOME=$KEMP_SCRATCH/hf_home                 # RFD4 weights (revision pinned in config/arms.yaml); offline after the first download

# --- scheduler ------------------------------------------------------------------------------------------------
export PLACER_GPU_PATTERN=H200      # PLACER ran only on GPUs whose name matches this (torch 2.3 / cu121 build); other GPUs hand it to a separate job
export NODE_PARTITION=gpu           # whole-node worker jobs (jobs/node_worker.sbatch)
export NODE_GPUS=8
export NODE_TIME=16:00:00
export SINGLE_PARTITION=gpu1        # one-GPU task jobs (jobs/task.sbatch)
